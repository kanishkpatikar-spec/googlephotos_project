# ─── Application ───────────────────────────────
# Application mode: "demo" uses synthetic data, "research" uses real data
APP_MODE=demo

# Port for the Next.js dev server
APP_PORT=3000

# SQLite database file path (relative to project root)
DATABASE_URL=file:./data/app.db

# Chroma vector store URL (if using remote Chroma)
CHROMA_URL=http://localhost:8000

# Chroma default collection name
CHROMA_COLLECTION=photos

# ─── AI Providers (configure at least one) ─────
# Active provider: "gemini" | "groq"
AI_PROVIDER=groq

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Groq
GROQ_API_KEY=
GROQ_MODEL=llama3-70b-8192

# ─── Image Processing ─────────────────────────
# Local CLIP model for image embeddings
CLIP_MODEL=Xenova/clip-vit-base-patch32

# Tesseract OCR language
OCR_LANGUAGE=eng

# ─── Feature Flags ────────────────────────────
# Automatically index photos on upload
ENABLE_AUTO_INDEXING=true

# Enable AI extraction in the discovery pipeline
ENABLE_AI_EXTRACTION=true

# Maximum file upload size in MB
MAX_UPLOAD_SIZE_MB=50

# Maximum batch size for evidence processing
MAX_BATCH_SIZE=100
